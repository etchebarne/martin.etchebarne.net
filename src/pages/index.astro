---
import BaseHead from '../components/BaseHead.astro';
import FormattedDate from '../components/FormattedDate.astro';
import { getCollection } from 'astro:content';
import { PROFILE, SITE_DESCRIPTION, SITE_TITLE, SOCIAL_LINKS } from '../consts';

const posts = (await getCollection('blog')).sort(
	(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
		<style>
			main {
				width: 880px;
			}

			.hero {
				display: grid;
				grid-template-columns: minmax(0, 1fr) 220px;
				align-items: center;
				gap: 3rem;
				padding: 2.5rem 0 4rem;
			}

			.eyebrow {
				margin: 0 0 0.75rem;
				color: rgb(var(--gray));
				font-size: 0.9rem;
				font-weight: 700;
				letter-spacing: 0.08em;
				text-transform: uppercase;
			}

			.hero h1 {
				margin-bottom: 1rem;
				font-size: clamp(2.4rem, 8vw, 4.75rem);
				letter-spacing: -0.06em;
			}

			.intro {
				max-width: 34rem;
				margin: 0;
				color: rgb(var(--gray-dark));
				font-size: 1.2rem;
			}

			.profile-image {
				width: 220px;
				aspect-ratio: 1;
				border-radius: 28px;
				object-fit: cover;
			}

			.socials {
				display: flex;
				flex-wrap: wrap;
				gap: 0.75rem;
				margin-top: 1.5rem;
			}

			.socials a {
				display: inline-flex;
				align-items: center;
				justify-content: center;
				width: 2rem;
				height: 2rem;
				color: rgb(var(--black));
				text-decoration: none;
			}

			.socials img {
				width: 1.6rem;
				height: 1.6rem;
				border-radius: 0;
				filter: invert(1);
			}

			.socials a:hover {
				border-color: rgb(var(--accent));
				color: rgb(var(--accent));
			}

			.posts-header {
				margin-bottom: 1.5rem;
			}

			.posts-header h2 {
				margin: 0;
				font-size: 1.75rem;
			}

			.post-list {
				display: grid;
				gap: 1rem;
				list-style: none;
				margin: 0;
				padding: 0;
			}

			.post-card a {
				display: block;
				border: 1px solid rgba(var(--gray), 18%);
				border-radius: 20px;
				padding: 1.25rem;
				background: rgba(var(--surface), 72%);
				color: inherit;
				text-decoration: none;
				transition:
					border-color 0.2s ease,
					box-shadow 0.2s ease,
					transform 0.2s ease;
			}

			.post-card a:hover {
				border-color: var(--accent);
				box-shadow: 0 12px 28px rgba(0, 0, 0, 28%);
				transform: translateY(-2px);
			}

			.post-card h3 {
				margin: 0 0 0.35rem;
				font-size: 1.25rem;
			}

			.post-card p {
				margin: 0;
			}

			.post-meta {
				color: rgb(var(--gray));
				font-size: 0.9rem;
			}

			.post-description {
				margin-top: 0.5rem !important;
				color: rgb(var(--gray-dark));
				font-size: 1rem;
			}

			@media (max-width: 720px) {
				.hero {
					grid-template-columns: 1fr;
					gap: 1.5rem;
					padding-top: 1rem;
				}

				.profile-image {
					grid-row: 1;
					width: 160px;
				}
			}
		</style>
	</head>
	<body>
		<main>
			<section class="hero" aria-labelledby="intro-heading">
				<div>
					<p class="eyebrow">{PROFILE.title}</p>
					<h1 id="intro-heading">{PROFILE.name}</h1>
					<p class="intro">{PROFILE.description}</p>
					<nav class="socials" aria-label="Social links">
						{
							SOCIAL_LINKS.map((link) => (
								<a href={link.href} aria-label={link.label} title={link.label} target="_blank" rel="noopener noreferrer">
									<img src={link.icon} alt="" aria-hidden="true" width="18" height="18" />
								</a>
							))
						}
					</nav>
				</div>
				<img class="profile-image" src={PROFILE.image} alt={`Portrait of ${PROFILE.name}`} />
			</section>

			<section aria-labelledby="posts-heading">
				<div class="posts-header">
					<h2 id="posts-heading">Latest writing</h2>
				</div>
				<ul class="post-list">
					{
						posts.map((post) => (
							<li class="post-card">
								<a href={`/post/${post.id}/`}>
									<h3>{post.data.title}</h3>
									<p class="post-meta">
										<FormattedDate date={post.data.pubDate} />
									</p>
									<p class="post-description">{post.data.description}</p>
								</a>
							</li>
						))
					}
				</ul>
			</section>
		</main>
	</body>
</html>
